+++ b/src/adapters/evolution/index.ts
@@ -170,22 +170,33 @@ export function evolution(options: EvolutionOptions): WaAdapter {
     fetch: options.fetch,
   });
 
+  // EvoAPI v2 exige o nome da inst├óncia no path; v1 resolve pelo apikey.
+  // Quando `options.instance` ├® fornecido, usamos os endpoints v2.
+  // v1: /send/text  ÔåÆ  v2: /message/sendText/{instance}
+  // v1: /send/media ÔåÆ  v2: /message/sendMedia/{instance}
+  const inst = options.instance;
+  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
+  const msgPath = (action: string) =>
+    inst ? `/message/send${cap(action)}/${inst}` : `/send/${action}`;
+  const instancePath = (action: string) =>
+    inst ? `/instance/${action}/${inst}` : `/instance/${action}`;
+
   const instance: InstanceApi = {
     connect: () => connectInstance(http, options),
-    status: () => statusInstance(http),
-    logout: () => logoutInstance(http),
+    status: () => statusInstance(http, inst),
+    logout: () => logoutInstance(http, inst),
   };
 
   const messages: MessagesApi = {
-    sendText: (input) => sendText(http, input),
-    sendMedia: (input) => sendMedia(http, input),
+    sendText: (input) => sendText(http, input, msgPath('text')),
+    sendMedia: (input) => sendMedia(http, input, msgPath('media')),
     sendReaction: (input) => sendReaction(http, input),
     edit: (input) => editMessage(http, input),
     delete: (input) => deleteMessage(http, input),
     markRead: (input) => markMessageRead(http, input),
-    sendLocation: (input) => sendLocation(http, input),
-    sendContactCard: (input) => sendContactCard(http, input),
-    sendPoll: (input) => sendPoll(http, input),
+    sendLocation: (input) => sendLocation(http, input, msgPath('location')),
+    sendContactCard: (input) => sendContactCard(http, input, msgPath('contact')),
+    sendPoll: (input) => sendPoll(http, input, msgPath('poll')),
     download: (input) => downloadMedia(http, input),
   };
 
